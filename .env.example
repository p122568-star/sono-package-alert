# 소노호텔 패키지 알리미 환경변수 설정 예시
# 이 파일을 복사하여 .env 로 저장 후 값을 채워주세요
# (실제 .env 파일은 절대 GitHub에 올리지 마세요!)

# 텔레그램 봇 설정
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# 소노호텔 회원 계정
SONO_ID=your_sono_member_id
SONO_PW=your_sono_member_password

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key
